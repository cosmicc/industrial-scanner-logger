#!/usr/bin/env bash
set -euo pipefail

# Installed systems use the project virtualenv so the report uses the exact
# package and dependency versions that run the receiver and API services.
INSTALL_DIR="${INSTALL_DIR:-/opt/industrial-scanner-logger}"
PYTHON_BIN="${PYTHON_BIN:-${INSTALL_DIR}/.venv/bin/python}"
SERVICE_USER="${SERVICE_USER:-scannerlogger}"
HEALTH_RUN_AS_SERVICE_USER="${HEALTH_RUN_AS_SERVICE_USER:-1}"

run_health_module() {
    local python_bin="$1"
    shift

    # The default PostgreSQL DSN uses local peer authentication for the service
    # user. When an operator runs this helper through sudo, collect health as
    # that same user so the CLI sees the same database rows as the web health
    # page and does not print misleading empty totals.
    if [[ "${HEALTH_RUN_AS_SERVICE_USER}" == "1" && "${EUID}" -eq 0 ]]; then
        if command -v runuser >/dev/null 2>&1 && id -u "${SERVICE_USER}" >/dev/null 2>&1; then
            if [[ -n "${PYTHONPATH:-}" ]]; then
                exec runuser -u "${SERVICE_USER}" -- env PYTHONPATH="${PYTHONPATH}" "${python_bin}" -m industrial_scanner_logger.health_cli "$@"
            fi

            exec runuser -u "${SERVICE_USER}" -- "${python_bin}" -m industrial_scanner_logger.health_cli "$@"
        fi
    fi

    exec "${python_bin}" -m industrial_scanner_logger.health_cli "$@"
}

if [[ -x "${PYTHON_BIN}" ]]; then
    run_health_module "${PYTHON_BIN}" "$@"
fi

# Checkout runs are useful before installation and during maintenance. The src
# path is added only when this script is still inside a project checkout.
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

if [[ -d "${PROJECT_ROOT}/src" ]]; then
    export PYTHONPATH="${PROJECT_ROOT}/src${PYTHONPATH:+:${PYTHONPATH}}"
fi

run_health_module python3 "$@"
