#!/usr/bin/env bash
set -euo pipefail

if [[ "${EUID}" -ne 0 ]]; then
    echo "update-services must be run as root. Re-run it with sudo." >&2
    exit 1
fi

INSTALL_DIR="${INSTALL_DIR:-/opt/industrial-scanner-logger}"
NGINX_WEB_ROOT="${NGINX_WEB_ROOT:-/var/www/scanner-site}"
CONFIG_FILE="${CONFIG_FILE:-/etc/industrial-scanner-logger.conf}"
SERVICE_NAME="${SERVICE_NAME:-industrial-scanner-logger}"
API_SERVICE_NAME="${API_SERVICE_NAME:-${SERVICE_NAME}-api}"
SERVICE_USER="${SERVICE_USER:-scannerlogger}"
SERVICE_GROUP="${SERVICE_GROUP:-${SERVICE_USER}}"
PYTHON_BIN="${PYTHON_BIN:-${INSTALL_DIR}/.venv/bin/python}"
UNIT_FILE="${UNIT_FILE:-/etc/systemd/system/${SERVICE_NAME}.service}"
API_UNIT_FILE="${API_UNIT_FILE:-/etc/systemd/system/${API_SERVICE_NAME}.service}"
SERVICE_TEMPLATE="${SERVICE_TEMPLATE:-${INSTALL_DIR}/systemd/industrial-scanner-logger.service}"
API_SERVICE_TEMPLATE="${API_SERVICE_TEMPLATE:-${INSTALL_DIR}/systemd/industrial-scanner-logger-api.service}"
HEALTH_BIN="${HEALTH_BIN:-/usr/local/bin/industrial-scanner-health}"
HEALTH_SOURCE="${HEALTH_SOURCE:-${INSTALL_DIR}/scripts/industrial-scanner-health}"
DEFAULT_POSTGRESQL_DSN="postgresql:///scannerlogger?host=/var/run/postgresql&user=scannerlogger"

postgresql_dsn() {
    python3 - "${CONFIG_FILE}" "${DEFAULT_POSTGRESQL_DSN}" <<'PY'
import configparser
import sys

config_path = sys.argv[1]
default_dsn = sys.argv[2]
config = configparser.ConfigParser(interpolation=None)
config.read_dict({"postgresql": {"dsn": default_dsn}})
config.read(config_path)
print(config.get("postgresql", "dsn"))
PY
}

escape_sed_replacement() {
    printf "%s" "$1" | sed "s/[&|]/\\\\&/g"
}

render_service_unit() {
    local source_template="$1"
    local destination_unit="$2"

    sed \
        -e "s|@INSTALL_DIR@|$(escape_sed_replacement "${INSTALL_DIR}")|g" \
        -e "s|@SERVICE_USER@|$(escape_sed_replacement "${SERVICE_USER}")|g" \
        -e "s|@SERVICE_GROUP@|$(escape_sed_replacement "${SERVICE_GROUP}")|g" \
        -e "s|@PYTHON_BIN@|$(escape_sed_replacement "${PYTHON_BIN}")|g" \
        "${source_template}" >"${destination_unit}"

    chmod 0644 "${destination_unit}"
}

echo "Updating database schema..."
POSTGRESQL_DSN="$(postgresql_dsn)"
if [[ "${POSTGRESQL_DSN}" == "${DEFAULT_POSTGRESQL_DSN}" ]]; then
    runuser -u postgres -- psql -d scannerlogger -f "${INSTALL_DIR}/db/schema.sql" > /dev/null 2>&1
else
    psql "${POSTGRESQL_DSN}" -f "${INSTALL_DIR}/db/schema.sql" > /dev/null 2>&1
fi
echo "Refreshing HTML data..."
cp "${INSTALL_DIR}/html/." "${NGINX_WEB_ROOT}/" -R > /dev/null 2>&1
echo "Refreshing systemd units..."
render_service_unit "${SERVICE_TEMPLATE}" "${UNIT_FILE}"
render_service_unit "${API_SERVICE_TEMPLATE}" "${API_UNIT_FILE}"
echo "Refreshing CLI health helper..."
install -d -o root -g root -m 0755 "$(dirname -- "${HEALTH_BIN}")"
install -o root -g root -m 0755 "${HEALTH_SOURCE}" "${HEALTH_BIN}"
systemctl daemon-reload > /dev/null 2>&1
echo "Restarting Scanner Service..."
systemctl restart "${SERVICE_NAME}" > /dev/null 2>&1
echo "Restarting API Service..."
systemctl restart "${API_SERVICE_NAME}" > /dev/null 2>&1
echo "Complete."
